generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @db.Char(36)
 email String? @unique @db.VarChar(320)
 passwordHash String? @db.VarChar(255)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 identities Identity[]
 sessions Session[]
 save PlayerSave?
 ledger EconomyLedger[]
 expeditions Expedition[]
 idempotency IdempotencyRecord[]
}
model Identity {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 provider String @db.VarChar(40)
 subject String @db.VarChar(255)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([provider, subject])
}
model Session {
 id String @id @default(uuid()) @db.Char(36)
 tokenHash String @unique @db.Char(64)
 userId String @db.Char(36)
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, expiresAt])
}
model PlayerSave {
 userId String @id @db.Char(36)
 version Int @default(1)
 state Json
 revision Int @default(0)
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model IdempotencyRecord {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 key String @db.VarChar(128)
 response Json
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([userId, key])
}
model EconomyLedger {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 eventKey String @unique @db.VarChar(180)
 amount Int
 balanceAfter Int
 reason String @db.VarChar(80)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, createdAt])
}
model Expedition {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 queueId String @unique @db.VarChar(120)
 planId String @db.VarChar(80)
 startedAt DateTime
 endsAt DateTime
 settledAt DateTime?
 rewardGold Int
 rewardXP Int
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([settledAt, endsAt])
}
