{
  "name": "vorzane-expo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/generate-character-model-variants.mjs && expo start --web",
    "preview": "node scripts/preview.mjs",
    "build": "node scripts/generate-character-model-variants.mjs && expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game/engine.test.mjs src/game/art.test.mjs src/game/characterAppearance.test.mjs src/lib/authErrors.test.mjs src/lib/offlineSaveMarker.test.mjs src/lib/economyCommand.test.mjs src/lib/saveConcurrency.test.mjs scripts/characterModelVariants.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
